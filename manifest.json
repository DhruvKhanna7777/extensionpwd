{
  "manifest_version": 3,
  "name": "AbleVerse AI",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "User-controlled reading, sensory comfort and verified SVG bar-chart accessibility. Reversible, with no AI uploads.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "read-selection": { "description": "Read selected page text" },
    "stop-speech": { "description": "Stop AbleVerse speech" },
    "restore-page": { "description": "Restore the original page" }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Lexend.ttf",
        "fonts/AtkinsonHyperlegible-Regular.ttf",
        "fonts/OpenDyslexic-Regular.woff2",
        "fonts/Lexend-OFL.txt",
        "fonts/AtkinsonHyperlegible-OFL.txt",
        "fonts/OpenDyslexic-OFL.txt",
        "fonts/provenance.json",
        "notices/svg-path-parser-LICENSE.txt"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AbleVerse AI",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:3187"
  }
}
