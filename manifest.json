{
 "manifest_version":3,"name":"AbleVerse AI","version":"0.1.0","minimum_chrome_version":"114",
 "description":"User-controlled reading, sensory comfort and verified SVG bar-chart accessibility. Reversible, with no AI uploads.",
 "permissions":["activeTab","scripting","storage","sidePanel"],
